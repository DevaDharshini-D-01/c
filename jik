#include <stdio.h>

void countingSort(int arr[], int n)
{
    int i, max = arr[0];

    // Find the maximum element
    for(i = 1; i < n; i++)
    {
        if(arr[i] > max)
            max = arr[i];
    }

    // Create count array
    int count[max + 1];

    // Initialize count array to 0
    for(i = 0; i <= max; i++)
        count[i] = 0;

    // Store the frequency of each element
    for(i = 0; i < n; i++)
        count[arr[i]]++;

    // Reconstruct the sorted array
    int index = 0;

    for(i = 0; i <= max; i++)
    {
        while(count[i] > 0)
        {
            arr[index] = i;
            index++;
            count[i]--;
        }
    }
}

int main()
{
    int n, i;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter the elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    countingSort(arr, n);

    printf("Sorted array:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    printf("\n");

    return 0;
}
