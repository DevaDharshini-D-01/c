#include <stdlib.h>

typedef struct Node {
    int val;
    struct Node* prev;
    struct Node* next;
} Node;

Node* createNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val = val;
    node->prev = NULL;
    node->next = NULL;
    return node;
}

typedef struct {
    Node* head;
    Node* tail;
    int size;
} Deque;

Deque* createDeque() {
    Deque* dq = (Deque*)malloc(sizeof(Deque));
    dq->head = NULL;
    dq->tail = NULL;
    dq->size = 0;
    return dq;
}

void dqPushFront(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = dq->tail = node;
    } else {
        node->next = dq->head;
        dq->head->prev = node;
        dq->head = node;
    }
    dq->size++;
}

void dqPushBack(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = dq->tail = node;
    } else {
        dq->tail->next = node;
        node->prev = dq->tail;
        dq->tail = node;
    }
    dq->size++;
}

int dqPopFront(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* temp = dq->head;
    int val = temp->val;
    dq->head = dq->head->next;
    if (dq->head) dq->head->prev = NULL;
    else dq->tail = NULL;
    free(temp);
    dq->size--;
    return val;
}

int dqPopBack(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* temp = dq->tail;
    int val = temp->val;
    dq->tail = dq->tail->prev;
    if (dq->tail) dq->tail->next = NULL;
    else dq->head = NULL;
    free(temp);
    dq->size--;
    return val;
}

typedef struct {
    Deque* front;
    Deque* back;
} FrontMiddleBackQueue;

void balance(FrontMiddleBackQueue* obj) {
    if (obj->front->size > obj->back->size) {
        int val = dqPopBack(obj->front);
        dqPushFront(obj->back, val);
    } else if (obj->back->size > obj->front->size + 1) {
        int val = dqPopFront(obj->back);
        dqPushBack(obj->front, val);
    }
}

FrontMiddleBackQueue* frontMiddleBackQueueCreate() {
    FrontMiddleBackQueue* obj = (FrontMiddleBackQueue*)malloc(sizeof(FrontMiddleBackQueue));
    obj->front = createDeque();
    obj->back = createDeque();
    return obj;
}

void frontMiddleBackQueuePushFront(FrontMiddleBackQueue* obj, int val) {
    dqPushFront(obj->front, val);
    balance(obj);
}

void frontMiddleBackQueuePushMiddle(FrontMiddleBackQueue* obj, int val) {
    if (obj->front->size == obj->back->size) {
        dqPushFront(obj->back, val);
    } else {
        dqPushBack(obj->front, val);
    }
    balance(obj);
}

void frontMiddleBackQueuePushBack(FrontMiddleBackQueue* obj, int val) {
    dqPushBack(obj->back, val);
    balance(obj);
}

int frontMiddleBackQueuePopFront(FrontMiddleBackQueue* obj) {
    if (obj->front->size + obj->back->size == 0) return -1;
    int val;
    if (obj->front->size > 0) {
        val = dqPopFront(obj->front);
    } else {
        val = dqPopFront(obj->back);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopMiddle(FrontMiddleBackQueue* obj) {
    if (obj->front->size + obj->back->size == 0) return -1;
    int val;
    if (obj->front->size == obj->back->size) {
        val = dqPopBack(obj->front);
    } else {
        val = dqPopFront(obj->back);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopBack(FrontMiddleBackQueue* obj) {
    if (obj->front->size + obj->back->size == 0) return -1;
    int val = dqPopBack(obj->back);
    balance(obj);
    return val;
}

void freeDeque(Deque* dq) {
    Node* curr = dq->head;
    while (curr) {
        Node* next = curr->next;
        free(curr);
        curr = next;
    }
    free(dq);
}

void frontMiddleBackQueueFree(FrontMiddleBackQueue* obj) {
    freeDeque(obj->front);
    freeDeque(obj->back);
    free(obj);
}
